{
  "name": "@mika/desktop",
  "version": "0.6.0",
  "private": true,
  "license": "LicenseRef-Proprietary",
  "description": "Mika — companheira VTuber para games, código e cultura nerd. Roda local no seu PC.",
  "author": "Mika System",
  "scripts": {
    "predev": "tsx ../../scripts/dev/node-runtime-guard.mts && pnpm build:prompts",
    "dev": "tauri dev --config src-tauri/tauri.conf.json",
    "build": "pnpm build:prompts && pnpm build:renderer",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "biome check src/",
    "test": "playwright test -c e2e/playwright.config.ts",
    "test:e2e": "pnpm build && playwright test -c e2e/playwright.config.ts",
    "test:e2e:headed": "pnpm build && playwright test -c e2e/playwright.config.ts --headed",
    "test:e2e:external": "pnpm build && playwright test -c e2e/playwright.config.ts --grep @external",
    "homologate:features": "playwright test -c e2e/homologation/playwright.config.ts",
    "dev:renderer": "vite -c vite.tauri.config.ts",
    "build:prompts": "tsx build/build-prompts.mts",
    "build:renderer": "vite build -c vite.tauri.config.ts",
    "tauri:dev": "tauri dev --config src-tauri/tauri.conf.json",
    "tauri:build": "tauri build --config src-tauri/tauri.conf.json",
    "build:e2e": "tsx ../../scripts/dev/build-e2e.mts",
    "build:app": "tauri build --config src-tauri/tauri.conf.json",
    "clean": "rimraf out",
    "build:win": "tauri build --config src-tauri/tauri.conf.json --bundles nsis",
    "build:mac": "tauri build --config src-tauri/tauri.conf.json --bundles dmg",
    "build:linux": "tauri build --config src-tauri/tauri.conf.json --bundles deb,appimage"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@mika/sdk": "workspace:*",
    "@mika/sdk-ui": "workspace:*",
    "@pixi/unsafe-eval": "6.5.10",
    "@pixiv/three-vrm": "3.5.5",
    "@pixiv/three-vrm-animation": "3.5.5",
    "@tauri-apps/api": "^2.12.4",
    "dompurify": "^3.4.17",
    "framer-motion": "^14.10.1",
    "lucide-react": "^1.70.0",
    "mermaid": "^12.3.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "8.22.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "smol-toml": "^1.9.1",
    "three": "0.187.0",
    "zod": "catalog:",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/audioworklet": "^0.0.100",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "playwright": "catalog:",
    "rimraf": "^6.1.4",
    "tailwindcss": "^4.3.5",
    "typescript": "catalog:",
    "vite": "^8.3.6"
  }
}
