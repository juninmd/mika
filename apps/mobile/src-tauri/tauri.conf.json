{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mika",
  "version": "0.0.1",
  "identifier": "com.mika.mobile",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:5373",
    "beforeDevCommand": "pnpm --filter @mika/mobile dev:renderer",
    "beforeBuildCommand": "pnpm --filter @mika/mobile build:renderer"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Mika" }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost blob:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["../../desktop/build/icon.png"]
  }
}
