{
  "name": "mika",
  "version": "0.6.0",
  "private": true,
  "license": "LicenseRef-Proprietary",
  "description": "Mika — AI Assistant with plugin architecture",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^24.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "setup:check": "tsx scripts/dev/setup-check.mts",
    "dev": "pnpm dev:desktop",
    "dev:desktop": "turbo run dev --filter=@mika/desktop",
    "dev:quick": "turbo run dev:quick --filter=@mika/desktop",
    "lint": "biome check .",
    "typecheck": "turbo run typecheck",
    "test": "pnpm --filter @mika/desktop test:e2e",
    "test:fuzzy": "vitest run packages/sdk/__tests__/fuzzy/ packages/sdk-ui/__tests__/fuzzy/",
    "test:fuzzy:sdk-ui": "vitest run packages/sdk-ui/__tests__/fuzzy/",
    "test:e2e": "pnpm --filter @mika/desktop test:e2e",
    "smoke": "pnpm --filter @mika/desktop build && pnpm --filter @mika/desktop exec playwright test -c e2e/playwright.config.ts --grep @smoke",
    "test:e2e:headed": "pnpm --filter @mika/desktop test:e2e:headed",
    "test:e2e:external": "pnpm --filter @mika/desktop test:e2e:external",
    "clean": "turbo run clean && rimraf node_modules",
    "icon:gen": "tsx scripts/generators/generate-app-icon.mts",
    "vad:fixtures": "tsx scripts/generators/generate-vad-fixtures.mts",
    "vrm:previews": "tsx scripts/generators/render-vrm-previews.mts",
    "live2d:analyze": "tsx scripts/live2d/live2d-analyze-model.mts",
    "live2d:gen": "tsx scripts/live2d/live2d-gen-motions.ts",
    "live2d:thumbs": "tsx scripts/live2d/live2d-gen-thumbs.mts",
    "check:versions": "tsx scripts/checks/versions.mts",
    "check:topology": "tsx scripts/checks/topology.mts",
    "check:file-naming": "tsx scripts/checks/file-naming.mts",
    "check:renderer": "tsx scripts/checks/renderer.mts",
    "check:boundaries": "tsx scripts/checks/boundaries.mts",
    "check:events": "tsx scripts/checks/events.mts",
    "check:event-literals": "tsx scripts/checks/event-literals.mts",
    "check:doc-paths": "tsx scripts/checks/doc-paths.mts",
    "check:log-discipline": "tsx scripts/checks/log-discipline.mts",
    "check:dead-deps": "tsx scripts/checks/dead-deps.mts",
    "check:no-hardcoded-speech": "tsx scripts/checks/no-hardcoded-speech.mts",
    "gates": "pnpm -s check:versions && pnpm -s check:topology && pnpm -s check:file-naming && pnpm -s check:renderer && pnpm -s check:boundaries && pnpm -s check:events && pnpm -s check:event-literals && pnpm -s check:doc-paths && pnpm -s check:log-discipline && pnpm -s check:dead-deps && pnpm -s check:dormant-modules && pnpm -s check:config-keys && pnpm -s check:pinned-downloads && pnpm -s check:external-http-logged && pnpm -s check:privacy-chokepoint && pnpm -s check:avatar-parity && pnpm -s check:expression-parity && pnpm -s check:packaged-assets && pnpm -s check:no-hardcoded-speech && pnpm -s check:module-manifest && pnpm -s check:module-ownership && pnpm -s check:prompt-files && pnpm -s check:test-reach && pnpm -s check:homologation-freshness && pnpm -s check:settings-nav && pnpm -s check:ui-controls && pnpm -s check:external-links && pnpm -s check:ui-style && pnpm -s check:ui-i18n && pnpm -s check:i18n-orphans && pnpm -s check:dead-ui && pnpm -s check:tauri-shell-actions && pnpm -s check:rust-logger && pnpm -s check:tauri-custom-protocol && pnpm -s check:sidecar-attrition && pnpm -s check:rust-include-paths && pnpm -s check:rust-event-consumers && pnpm -s check:config-schema-parity && pnpm -s check:config-read-paths && pnpm -s check:config-ui-consumed && pnpm -s check:license-policy && pnpm -s check:release-docs && pnpm -s test:rust",
    "test:unit": "vitest run --reporter=dot --coverage",
    "test:unit:watch": "vitest",
    "check:config-keys": "tsx scripts/checks/config-keys.mts",
    "check:avatar-parity": "tsx scripts/checks/avatar-parity.mts",
    "check:expression-parity": "tsx scripts/checks/expression-parity.mts",
    "check:packaged-assets": "tsx scripts/checks/packaged-assets.mts",
    "check:external-http-logged": "tsx scripts/checks/external-http-logged.mts",
    "check:privacy-chokepoint": "tsx scripts/checks/privacy-chokepoint.mts",
    "check:dormant-modules": "tsx scripts/checks/dormant-modules.mts",
    "check:module-manifest": "tsx scripts/checks/module-manifest.mts",
    "check:prompt-files": "tsx scripts/checks/prompt-files.mts",
    "check:test-reach": "tsx scripts/checks/test-reach.mts",
    "check:homologation-freshness": "tsx scripts/checks/homologation-freshness.mts",
    "check:settings-nav": "tsx scripts/checks/settings-nav.mts",
    "check:ui-controls": "tsx scripts/checks/ui-controls.mts",
    "check:external-links": "tsx scripts/checks/external-links.mts",
    "check:ui-style": "tsx scripts/checks/ui-style.mts",
    "check:ui-i18n": "tsx scripts/checks/ui-i18n.mts",
    "check:i18n-orphans": "tsx scripts/checks/i18n-orphans.mts",
    "check:dead-ui": "tsx scripts/checks/dead-ui.mts",
    "check:module-ownership": "tsx scripts/checks/module-ownership.mts",
    "check:tauri-shell-actions": "tsx scripts/checks/tauri-shell-actions.mts",
    "homologate": "tsx scripts/homologate.mts",
    "test:coverage": "vitest run --reporter=dot --coverage",
    "check:pinned-downloads": "tsx scripts/checks/pinned-downloads.mts",
    "test:rust": "cargo test --quiet --manifest-path apps/desktop/src-tauri/Cargo.toml --lib",
    "check:rust-logger": "tsx scripts/checks/rust-logger.mts",
    "check:tauri-custom-protocol": "tsx scripts/checks/tauri-custom-protocol.mts",
    "check:sidecar-attrition": "tsx scripts/checks/sidecar-attrition.mts",
    "check:rust-include-paths": "tsx scripts/checks/rust-include-paths.mts",
    "check:rust-event-consumers": "tsx scripts/checks/rust-event-consumers.mts",
    "check:config-schema-parity": "tsx scripts/checks/config-schema-parity.mts",
    "check:config-read-paths": "tsx scripts/checks/config-read-paths.mts",
    "check:config-ui-consumed": "tsx scripts/checks/config-ui-consumed.mts",
    "notices:gen": "tsx scripts/generators/third-party-notices.mts",
    "check:license-policy": "tsx scripts/checks/license-policy.mts",
    "check:release-docs": "tsx scripts/checks/release-docs.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@mika/desktop": "workspace:*",
    "@mika/sdk": "workspace:*",
    "@playwright/test": "catalog:",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "^0.28.2",
    "playwright": "catalog:",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "vitest": "^5.1.0",
    "zod": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "zod": "catalog:",
      "gh-pages": "^6.0.0",
      "qs": "^6.16.0",
      "lodash-es": "^4.18.1",
      "katex": ">=0.18.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    },
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  }
}
