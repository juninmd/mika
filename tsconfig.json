{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@mika/sdk": [
        "./packages/sdk/src"
      ],
      "@mika/sdk/*": [
        "./packages/sdk/src/*"
      ],
      "@mika/sdk-ui": [
        "./packages/sdk-ui/src/index.tsx"
      ],
      "@mika/sdk-ui/*": [
        "./packages/sdk-ui/src/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ]
}
