# Saida de execucao da homologacao E2E (relatorio de um run, nunca baseline).
# `homologation/playwright.config.ts` escreve `report/results.json` + `report/artifacts/`, e os
# specs gravam catalog/features/settings-paths/duolingo. Versionado, o relatorio congela o estado
# de um boot antigo e passa por atual — foi o que aconteceu com os ~84 nomes de tools pre-unificacao.
apps/desktop/e2e/homologation/report/
# Screenshots e dumps que a suite E2E grava a cada execucao. O cabecalho la em cima ja dizia
# "screenshots — regenerated, never commit", mas so o `tools-catalog.json` estava listado: os ~40
# PNGs voltavam sujando a arvore em todo `pnpm test:e2e`, e um `git add -A` os recommitava (foi
# preciso apaga-los a mao em 2026-08-27). Eles sao PROVA de uma execucao, nao baseline — servem
# para olhar depois de rodar, e congelados no repositorio passam por estado atual.
apps/desktop/e2e/screenshots/

# Hermes agent local plans/workspace (not product)
.hermes/

# PoC three-vrm: modelo de amostra baixado por scripts/poc/vrm-poc.mts
apps/desktop/src/renderer/public/vrm/sample.vrm

# HTML de entrada do alvo Tauri: derivado de index.html no build, artefato e nao fonte.
apps/desktop/src/renderer/index.tauri.html

# Schemas de ACL gerados pelo tauri-build a cada compilacao.
apps/desktop/src-tauri/gen/

